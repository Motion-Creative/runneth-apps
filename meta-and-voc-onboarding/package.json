{
  "schemaVersion": 1,
  "id": "meta-and-voc-onboarding",
  "name": "Meta and Voice of Customer Onboarding",
  "version": "6",
  "description": "Available only through an explicit package install. Stages Meta and Voice of Customer onboarding docs, ready-made guard blocks, and the voc-data-pull, voc-audit, meta-ad-performance-analysis, onboarding-walkthrough, and dashboard-design skills. Activation asks before connected-account reads or persistent setup. After approval, Runneth maps the active Motion workspace to a brand home, keeps Meta interpretation under brands/<brand>/integrations/meta/, keeps reviews, comments, support, and community evidence under brands/<brand>/customer-feedback/, creates the applicable daily VoC sync routines, and records completion. Knoweth V2 keeps shared Brain knowledge global, assigns each brand home to its existing project:<workspaceId>, and assigns verified personal homes to user:<vmUserId> without exposing lanes or grants to customers.",
  "installPolicy": "manual",
  "updatePolicy": "auto",
  "uninstallPolicy": "allowed",
