      "sourcePath": "app-template",
      "executablePaths": [],
      "target": {
        "root": "agent_brain",
        "path": "ai-work-systems-observatory/app-template"
      }
    },
    {
      "id": "observatory-collector",
      "type": "directory",
      "sourcePath": "tools/collect-system-ledger",
      "executablePaths": [
        "collect.mjs"
      ],
      "target": {
