{
  "schemaVersion": 1,
  "id": "ai-work-systems-observatory",
  "name": "AI Work Systems Observatory",
  "version": "2",
  "description": "Stages a portable executive operating-model report that separates verified current work systems from strategist recommendations. It includes governed observed-state and proposed-model contracts, deterministic inventory classification, strict validation, approved setup and refresh skills, and a private runtime-loaded report template. Installation only delivers files. Setup discloses every intended read and write, uses bounded evidence retrieval, preserves unresolved facts, and waits for approval before organization-specific discovery or activation.",
  "installPolicy": "manual",
  "updatePolicy": "auto",
  "uninstallPolicy": "allowed",
  "resources": [
    {
      "id": "readme",
      "type": "file",
      "sourcePath": "README.md",
      "executable": false,
      "target": {
        "root": "agent_brain",
        "path": "ai-work-systems-observatory/README.md"
      }
    },
    {
      "id": "observatory-reference",
      "type": "directory",
      "sourcePath": "brain",
      "executablePaths": [],
