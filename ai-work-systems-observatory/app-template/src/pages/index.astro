---
import Base from "../layouts/Base.astro";
import observatoryControllerUrl from "../scripts/observatory-controller.ts?url";
---

<Base title="AI Work Systems Observatory">
  <wa-page class="wa-cloak" mobile-breakpoint="920">
    <header slot="header">
      <layout-split gap="m" align-items="center">
        <layout-stack gap="3xs">
          <strong>AI Work Systems Observatory</strong>
          <span class="meta-copy" data-bind="organizationName">Loading organization</span>
        </layout-stack>
        <buildeth-theme-toggle></buildeth-theme-toggle>
      </layout-split>
    </header>

    <nav slot="navigation">
      <layout-stack gap="s">
        <span class="eyebrow">Views</span>
        <a href="#executive" data-drawer="close">Executive overview</a>
        <a href="#teams" data-drawer="close">How teams work</a>
        <a href="#systems" data-drawer="close">Operating systems</a>
        <a href="#risks" data-drawer="close">Risks and decisions</a>
      </layout-stack>
    </nav>

    <main>
      <layout-stack gap="3xl">
        <wa-callout id="illustrative-banner" variant="warning" appearance="filled-outlined" hidden>
          <wa-icon slot="icon" name="info"></wa-icon>
          Illustrative data only. Replace this sample with an approved organization ledger before sharing the dashboard as a live operating review.
        </wa-callout>

        <wa-callout id="load-error" class="error-state" variant="danger" appearance="outlined" hidden>
          <wa-icon slot="icon" name="warning"></wa-icon>
          The dashboard data could not be loaded. Check the app data file and source coverage before relying on this view.
        </wa-callout>

        <section id="executive">
          <layout-stack gap="xl">
            <layout-stack gap="s">
              <span class="eyebrow">Executive operating review</span>
              <h1>From AI activity to owned systems</h1>
              <p class="hero-copy" data-bind="executiveSummary">Loading the operating narrative.</p>
              <layout-cluster gap="s" align-items="center">
                <wa-tag variant="neutral" appearance="filled-outlined" size="s">
                  Refreshed <span data-bind="refreshedAt">unknown</span>
                </wa-tag>
                <wa-tag variant="brand" appearance="filled-outlined" size="s">
                  Team-level by default
                </wa-tag>
              </layout-cluster>
            </layout-stack>

            <kpi-strip id="executive-kpis"></kpi-strip>

            <layout-grid gap="m" style="--min-column-size: 18rem">
              <wa-card appearance="filled-outlined" with-header>
                <h3 slot="header" data-bind="narrativeTitle0">What changed</h3>
                <p data-bind="narrativeBody0">Loading.</p>
              </wa-card>
              <wa-card appearance="filled-outlined" with-header>
                <h3 slot="header" data-bind="narrativeTitle1">Evidence of value</h3>
                <p data-bind="narrativeBody1">Loading.</p>
              </wa-card>
              <wa-card appearance="filled-outlined" with-header>
                <h3 slot="header" data-bind="narrativeTitle2">Decision required</h3>
                <p data-bind="narrativeBody2">Loading.</p>
              </wa-card>
            </layout-grid>

            <layout-stack gap="s">
              <layout-split gap="m" align-items="end">
                <layout-stack gap="3xs">
                  <h2>System maturity</h2>
                  <p class="section-copy">Operating structure only. Maturity does not prove effectiveness or business value.</p>
                </layout-stack>
                <wa-tag variant="neutral" appearance="outlined" size="s">Levels 0 to 5</wa-tag>
              </layout-split>
              <creative-chart
                id="maturity-chart"
                type="bar"
                x-key="level"
                label-key="label"
                height="320"
                show-grid
                show-tooltip
                show-value-labels
              ></creative-chart>
            </layout-stack>
          </layout-stack>
        </section>

        <section id="teams" class="section-rule">
          <layout-stack gap="l">
            <layout-stack gap="s">
              <span class="eyebrow">How teams work</span>
              <h2>Coverage and operating shape</h2>
              <p class="section-copy">Activity is shown only as context. It is not a people ranking and does not prove productivity.</p>
            </layout-stack>
            <creative-table id="teams-table" sticky-first-column hover-rows></creative-table>
          </layout-stack>
        </section>

        <section id="systems" class="section-rule">
          <layout-stack gap="l">
            <layout-stack gap="s">
              <span class="eyebrow">Operating systems</span>
              <h2>The meaningful-workflow ledger</h2>
              <p class="section-copy">Each system carries ownership, trigger, provenance, output, control, health, evidence, and a maintenance path.</p>
            </layout-stack>
            <creative-table id="systems-table" sticky-first-column hover-rows page-size="10" page-size-options="[10,25,50]"></creative-table>
          </layout-stack>
        </section>

        <section id="risks" class="section-rule">
          <layout-stack gap="xl">
            <layout-stack gap="s">
              <span class="eyebrow">Risks and decisions</span>
              <h2>Where leadership needs to intervene</h2>
              <p class="section-copy">Missing evidence stays missing. The Observatory does not convert a source gap into a zero or a negative judgment.</p>
            </layout-stack>

            <layout-stack gap="s">
              <h3>Current risks</h3>
              <creative-table id="risks-table" sticky-first-column hover-rows></creative-table>
            </layout-stack>

            <layout-stack gap="s">
              <h3>Decisions required</h3>
              <creative-table id="decisions-table" sticky-first-column hover-rows></creative-table>
            </layout-stack>

            <layout-grid gap="m" style="--min-column-size: 20rem">
              <wa-card appearance="filled-outlined" with-header>
                <h3 slot="header">Source coverage</h3>
                <layout-stack gap="s">
                  <p class="meta-copy" data-bind="sourceCoverageSummary">Loading source coverage.</p>
                  <layout-cluster id="source-list" class="source-list" gap="xs" align-items="center"></layout-cluster>
                </layout-stack>
              </wa-card>
              <wa-card appearance="filled-outlined" with-header>
                <h3 slot="header">Evidence boundary</h3>
                <p data-bind="evidenceBoundary">Executed is not the same as delivered, consumed, used, outcome linked, or validated value.</p>
              </wa-card>
            </layout-grid>

            <wa-details summary="Methodology and privacy rules" appearance="filled-outlined">
              <layout-stack gap="s">
                <p data-bind="methodology">Loading methodology.</p>
                <p data-bind="privacy">Loading privacy rules.</p>
              </layout-stack>
            </wa-details>
          </layout-stack>
        </section>
      </layout-stack>
    </main>
  </wa-page>
  <script is:inline type="module" src={observatoryControllerUrl}></script>
</Base>
