---
// Context Kit board. Client-rendered so it mirrors mutable brain state without a rebuild.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Runneth | Context Kit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root{--gray-0:#ffffff;--page-bg:#ffffff;--surface:#f6f6f6;--ink:#1c180e;--muted:#6b6757;--lime:#ceff5b;--limeS:#f5ffd9;--limeB:#e1f5a8;--butter:#fff3c4;--butterB:#e8b840;--sky:#aee1ed;--green:#3fb55c;--greenD:#1f7a3a;--border:#ededed;--r:10px;}
      *{box-sizing:border-box;margin:0;padding:0}
      body{font-family:"Inter",system-ui,sans-serif;background:var(--page-bg);color:var(--ink);line-height:1.5;-webkit-font-smoothing:antialiased}
      .wrap{max-width:960px;margin:0 auto;padding:44px 24px 90px}
      h1{font-size:clamp(28px,4vw,40px);font-weight:800;letter-spacing:-.025em;margin-bottom:10px}
      .lede{font-size:15.5px;color:var(--muted);max-width:640px}
      /* compact integration nudge */
      .int-nudge{display:flex;align-items:center;gap:13px;margin-top:18px;padding:12px 16px;background:var(--gray-0);border:1px solid var(--border);border-radius:var(--r);max-width:540px;box-shadow:0 1px 4px rgba(0,0,0,.05)}
      .nudge-icon{width:34px;height:34px;border-radius:8px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
      .nudge-head{font-size:13px;font-weight:700;color:var(--ink);margin-bottom:2px}
      .nudge-sub{font-size:12px;color:var(--muted);line-height:1.45}
      /* progress path */
      .path{display:flex;align-items:flex-start;gap:0;margin:28px 0 0}
      .step{flex:1;display:flex;flex-direction:column;align-items:center;text-align:center;position:relative}
      .step .line{position:absolute;top:15px;left:-50%;width:100%;height:2px;background:var(--border);z-index:0}
      .step.passed .line,.step.current .line{background:var(--lime)}
      .step:first-child .line{display:none}
      .circ{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;background:var(--surface);border:2px solid var(--border);color:var(--muted);position:relative;z-index:1}
      .step.passed .circ{background:var(--lime);border-color:var(--lime);color:var(--ink)}
      .step.current .circ{background:#fff;border-color:var(--lime);color:var(--ink);box-shadow:0 0 0 3px var(--limeS)}
      .step .badge{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-top:8px}
      .step.current .badge{color:var(--ink)}
      .step .sname{font-size:12.5px;font-weight:600;color:var(--ink);margin-top:2px;max-width:130px}
      .step.locked{opacity:.55}
      /* pips */
      .prog-row{display:flex;align-items:center;gap:10px;margin-top:18px}
      .pips{display:flex;gap:3px;flex-wrap:wrap}
      .pip{width:18px;height:8px;border-radius:3px;background:var(--border)}
      .pip.on{background:var(--lime)}
      .prog-label{font-size:13.5px;color:var(--muted);font-weight:500;white-space:nowrap}
      .prog-label strong{color:var(--ink);font-weight:700}
      /* groups + cards */
      .group{margin-top:28px}
      .gh{font-size:15px;font-weight:800;display:flex;align-items:center;gap:7px}
      .gs{font-size:12.5px;color:var(--muted);margin:2px 0 14px}
      .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
      @media(max-width:640px){.grid{grid-template-columns:1fr}}
      .card{border:1px solid var(--border);border-radius:var(--r);background:var(--gray-0);cursor:pointer;transition:.12s}
      .card:hover{border-color:var(--ink)}
      .card.confirmed,.card.imported{background:var(--limeS);border-color:var(--limeB)}
      .card.inferred{background:#eef7fb;border-color:var(--sky)}
      .card.drafted{background:var(--butter);border-color:var(--butterB)}
      .card-main{padding:16px 18px}
      .cname{font-weight:700;font-size:15px}
      .cwhy{font-size:13px;color:var(--muted);margin:6px 0 12px;min-height:34px}
      .foot{display:flex;align-items:center;justify-content:space-between;gap:10px}
      .st{font-size:12px;font-weight:700;padding:4px 9px;border-radius:4px}
      .st.confirmed,.st.imported{background:var(--green);color:#fff}
      .st.inferred{background:var(--sky);color:#0b4a59}
      .st.drafted{background:var(--butterB);color:#4a3600}
      .st.missing{background:var(--butter);color:#6e5500}
      .foot .cta{font-size:13px;font-weight:700;color:var(--ink)}
      .card-panel{display:none;border-top:1px solid var(--border);padding:16px 18px;font-size:13.5px;color:var(--ink);background:rgba(255,255,255,.55);max-height:460px;overflow:auto}
      .card.open .card-panel{display:block}
      .card-panel h2,.card-panel h3{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin:12px 0 5px;padding-bottom:3px;border-bottom:1px solid var(--border);font-weight:700}
      .card-panel p{margin:6px 0}
      .card-panel ul,.card-panel ol{margin:5px 0 5px 16px}
      .card-panel li{margin:3px 0;line-height:1.6}
      .card-panel blockquote{margin:8px 0;padding:8px 12px;background:var(--surface);border-left:3px solid var(--border);border-radius:0 6px 6px 0;color:var(--muted);font-size:12.5px;font-style:italic}
      .card-panel table{border-collapse:collapse;width:100%;margin:10px 0;font-size:12.5px}
      .card-panel th{background:var(--surface);font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);padding:6px 10px;border:1px solid var(--border);text-align:left}
      .card-panel td{padding:6px 10px;border:1px solid var(--border);vertical-align:top}
      .card-panel td:first-child{font-weight:600}
      .card-panel hr{border:0;border-top:1px solid var(--border);margin:10px 0}
      .card-panel .empty{color:var(--muted);font-style:italic}
      .source-note{font-size:11.5px;color:var(--muted);font-style:italic;padding-bottom:12px;margin-bottom:12px;border-bottom:1px solid var(--border);line-height:1.55}
      .enrich{display:block;margin-top:12px;padding:9px 12px;border:1px dashed var(--sky);border-radius:8px;background:#eef7fb;color:#0b4a59;font-size:12.5px}
      .thought-starters{margin-top:13px;padding-top:13px;border-top:1px solid var(--border)}
      .ts-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:8px}
      .ts-list{list-style:none;padding:0;display:flex;flex-direction:column;gap:5px;margin:0}
      .ts-list li{font-size:13px;padding:7px 10px 7px 28px;position:relative;background:var(--surface);border-radius:7px;border:1px solid var(--border);line-height:1.5}
      .ts-list li::before{content:"\2192";position:absolute;left:10px;top:8px;color:var(--muted);font-size:12px}
      .help-banner{display:flex;align-items:flex-start;gap:12px;margin-top:32px;padding:16px 20px;border:1px solid var(--border);border-radius:var(--r);background:var(--surface);font-size:14px;color:var(--ink);line-height:1.55}
      .help-banner .icon{font-size:18px;flex-shrink:0;margin-top:1px}
      .gaps{margin-top:18px;padding:14px 16px;border:1px dashed var(--butterB);border-radius:var(--r);background:#fffaf0}
      .gaps-head{font-size:12px;font-weight:800;color:var(--ink);margin-bottom:8px;display:flex;align-items:center;gap:6px}
      .gaps ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:5px}
      .gaps li{font-size:12.5px;color:var(--ink);padding-left:16px;position:relative;line-height:1.5}
      .gaps li::before{content:"\2022";position:absolute;left:3px;color:var(--butterB)}
      .gaps .lbl{font-weight:700}
    </style>
  </head>
  <body>
    <div class="wrap">
      <h1 id="page-title">Context Kit</h1>
      <p class="lede">The more Runneth knows about your brand, the sharper every answer. Confirm what we pulled, review what we drafted, add the few things only you know.</p>
      <div class="int-nudge" id="nudge">
        <div class="nudge-icon">🔗</div>
        <div>
          <div class="nudge-head">Import from Google Drive or Notion</div>
          <div class="nudge-sub">Connect them in chat and Runneth can pull your brand docs directly.</div>
        </div>
      </div>
      <div id="board"></div>
      <div class="help-banner">
        <span class="icon">💡</span>
        <span><strong>This board mirrors your brain.</strong> Click any card to review what Runneth has saved. Tell Runneth in chat to update anything, or ask it to pull up any file anytime. Refresh after a chat update to see the latest.</span>
      </div>
    </div>

    <script is:inline type="text/javascript">
      const BASE = "/context-kit";
      const statusLabel = { confirmed:"Confirmed", imported:"Imported", inferred:"Needs confirm", drafted:"Review draft", missing:"Not yet" };
      const BUCKETS = [
        { key:"A", icon:"⚡", title:"From Motion — just confirm", sub:"Pulled from your Motion setup. One tap to lock in." },
        { key:"B", icon:"✏️", title:"Runneth drafted these", sub:"Built from your data. Review and correct anything off." },
        { key:"C", icon:"🔑", title:"Only you know these", sub:"Runneth will walk you through each one in chat." },
      ];
      function esc(s){return (s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");}
      function inline(s){return esc(s).replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>").replace(/(^|[^*])\*(?!\*)(.+?)\*(?!\*)/g,"$1<em>$2</em>");}
      // full line-by-line markdown renderer
      function md(src){
        const lines=(src||"").replace(/\r/g,"").split("\n");
        let html="",list=null,tbl=null;
        const closeList=()=>{ if(list){ html+="</"+list+">"; list=null; } };
        const closeTbl=()=>{ if(tbl){ html+="</tbody></table>"; tbl=null; } };
        const closeAll=()=>{ closeList(); closeTbl(); };
        for(let raw of lines){
          const line=raw.replace(/\s+$/,"");
          if(!line.trim()){ closeAll(); continue; }
          const trow=line.trim();
          if(/^\|(.+)\|$/.test(trow)){
            const cells=trow.slice(1,-1).split("|").map(c=>c.trim());
            if(cells.every(c=>/^:?-{2,}:?$/.test(c))) continue; // separator
            if(!tbl){ closeList(); tbl="th"; html+="<table><thead><tr>"+cells.map(c=>"<th>"+inline(c)+"</th>").join("")+"</tr></thead><tbody>"; continue; }
            html+="<tr>"+cells.map(c=>"<td>"+inline(c)+"</td>").join("")+"</tr>"; continue;
          } else closeTbl();
          if(/^#{2,3}\s+/.test(line)){ closeAll(); const lvl=line.startsWith("### ")?3:2; html+="<h"+lvl+">"+inline(line.replace(/^#{2,3}\s+/,""))+"</h"+lvl+">"; continue; }
          if(/^#\s+/.test(line)){ closeAll(); html+="<h2>"+inline(line.replace(/^#\s+/,""))+"</h2>"; continue; }
          if(/^---+$/.test(line.trim())){ closeAll(); html+="<hr>"; continue; }
          if(/^>\s?/.test(line)){ closeList(); html+="<blockquote>"+inline(line.replace(/^>\s?/,""))+"</blockquote>"; continue; }
          let m;
          if((m=line.match(/^\s*[-*]\s+(.*)$/))){ if(list!=="ul"){ closeList(); list="ul"; html+="<ul>"; } html+="<li>"+inline(m[1])+"</li>"; continue; }
          if((m=line.match(/^\s*\d+\.\s+(.*)$/))){ if(list!=="ol"){ closeList(); list="ol"; html+="<ol>"; } html+="<li>"+inline(m[1])+"</li>"; continue; }
          closeList(); html+="<p>"+inline(line)+"</p>";
        }
        closeAll(); return html;
      }
      function emptyMsg(item){
        if(item.bucket==="A") return "Not confirmed yet. Tell Runneth \"confirm my "+esc(item.label)+"\" in chat to lock it in.";
        if(item.bucket==="B") return "Runneth hasn't researched this yet. Say \"build my Context Kit\" in chat and Runneth will draft it for you.";
        return "Only you can answer this one. Say \"fill in my "+esc(item.label)+"\" in chat and Runneth will walk you through it.";
      }
      function enrichHtml(item){ return item.enrich ? "<div class='enrich'>\u2728 <strong>Tip:</strong> "+esc(item.enrich)+"</div>" : ""; }
      function sourceNoteHtml(item){ return item.sourceNote ? "<div class='source-note'>"+esc(item.sourceNote)+"</div>" : ""; }
      function thoughtHtml(item){
        if(!(item.thoughtStarters && item.thoughtStarters.length)) return "";
        return "<div class='thought-starters'><div class='ts-label'>Think through</div><ul class='ts-list'>"+item.thoughtStarters.map(t=>"<li>"+esc(t)+"</li>").join("")+"</ul></div>";
      }
      async function loadPanel(item, panel){
        const filled = ["confirmed","imported","drafted"].includes(item.status);
        const file = item.dataFile || (item.id+".md");
        let content;
        if(filled){
          try{
            const r = await fetch(BASE+"/data/"+file,{cache:"no-store"});
            if(!r.ok) throw 0;
            content = sourceNoteHtml(item) + md(await r.text());
          }catch(e){
            content = "<p class='empty'>"+ (item.bucket==="B" ? "This file hasn't been saved yet. Say \"build my Context Kit\" in chat and Runneth will fill it in." : emptyMsg(item)) +"</p>";
          }
        } else if(item.bucket==="A" && item.preview){
          content = "<p>"+esc(item.preview)+"</p><p class='empty'>"+emptyMsg(item)+"</p>";
        } else {
          content = "<p class='empty'>"+emptyMsg(item)+"</p>" + thoughtHtml(item);
        }
        panel.innerHTML = content + enrichHtml(item);
      }
      function render(state){
        const items = state.items || [];
        const total = items.length;
        const confirmed = items.filter(i=>["confirmed","imported"].includes(i.status)).length;
        const title = document.getElementById("page-title");
        title.textContent = (state.brandName && state.brandName.trim()) ? state.brandName.trim()+"'s Context Kit" : "Context Kit";
        const nudge = document.getElementById("nudge");
        if(nudge) nudge.style.display = (confirmed===total) ? "none" : "flex";
        const board = document.getElementById("board");
        board.innerHTML = "";
        // progress path
        const path=document.createElement("div"); path.className="path";
        (state.levels||[]).forEach((l,idx)=>{
          const badge = l.state==="passed"?"Done":l.state==="current"?"You're here":"Locked";
          const mark = l.state==="passed"?"\u2713":l.state==="locked"?"\uD83D\uDD12":String(idx+1);
          const s=document.createElement("div"); s.className="step "+l.state;
          s.innerHTML="<div class='line'></div><div class='circ'>"+mark+"</div><div class='badge'>"+badge+"</div><div class='sname'>"+esc(l.name)+"</div>";
          path.appendChild(s);
        });
        board.appendChild(path);
        // pips row
        const pr=document.createElement("div"); pr.className="prog-row";
        let pips=""; items.forEach(i=>{ pips+="<span class='pip"+(["confirmed","imported"].includes(i.status)?" on":"")+"'></span>"; });
        pr.innerHTML="<div class='pips'>"+pips+"</div><div class='prog-label'><strong>"+confirmed+" of "+total+"</strong> confirmed</div>";
        board.appendChild(pr);
        // self-improvement nudges Runneth has flagged
        const gaps=(state.gaps||[]);
        if(gaps.length){
          const labelOf={}; items.forEach(i=>labelOf[i.id]=i.label);
          const gd=document.createElement("div"); gd.className="gaps";
          gd.innerHTML="<div class='gaps-head'>\u2728 Runneth wants to sharpen these</div><ul>"+
            gaps.slice(0,6).map(g=>"<li><span class='lbl'>"+esc(labelOf[g.item]||g.item||"")+":</span> "+esc(g.note||"")+"</li>").join("")+"</ul>";
          board.appendChild(gd);
        }
        // groups
        BUCKETS.forEach(b=>{
          const list = items.filter(i=>i.bucket===b.key);
          if(!list.length) return;
          const g=document.createElement("div"); g.className="group";
          g.innerHTML="<div class='gh'>"+b.icon+" "+b.title+"</div><div class='gs'>"+b.sub+"</div>";
          const grid=document.createElement("div"); grid.className="grid";
          list.forEach(item=>{
            const card=document.createElement("div"); card.className="card "+item.status;
            card.innerHTML="<div class='card-main'><div class='cname'>"+esc(item.label)+"</div><div class='cwhy'>"+esc(item.why||"")+"</div><div class='foot'><span class='st "+item.status+"'>"+(statusLabel[item.status]||item.status)+"</span><span class='cta'>View \u2192</span></div></div><div class='card-panel'>Loading...</div>";
            const panel=card.querySelector(".card-panel");
            let loaded=false;
            card.querySelector(".card-main").addEventListener("click",()=>{
              const isOpen=card.classList.contains("open");
              document.querySelectorAll(".card.open").forEach(c=>c.classList.remove("open"));
              if(!isOpen){ card.classList.add("open"); if(!loaded){ loaded=true; loadPanel(item,panel); } }
            });
            grid.appendChild(card);
          });
          g.appendChild(grid); board.appendChild(g);
        });
      }
      (async ()=>{
        try{
          const r = await fetch(BASE+"/data/context-kit-state.json",{cache:"no-store"});
          render(await r.json());
        }catch(e){
          document.getElementById("board").innerHTML="<p class='empty'>Could not load your Context Kit state yet.</p>";
        }
      })();
    </script>
  </body>
</html>
