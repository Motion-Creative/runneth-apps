---
// Context Kit board. Client-rendered so it mirrors mutable brain state without a rebuild.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Runneth | Context Kit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root{--gray-0:#ffffff;--page-bg:#ffffff;--surface:#f6f6f6;--ink:#1c180e;--muted:#6b6757;--lime:#ceff5b;--limeS:#f5ffd9;--limeB:#e1f5a8;--butter:#ffe99a;--sky:#aee1ed;--green:#3fb55c;--greenD:#1f7a3a;--border:#ededed;--r:10px;}
      *{box-sizing:border-box;margin:0;padding:0}
      body{font-family:"Inter",system-ui,sans-serif;background:var(--page-bg);color:var(--ink);line-height:1.5;-webkit-font-smoothing:antialiased}
      .wrap{max-width:960px;margin:0 auto;padding:44px 24px 90px}
      .kicker{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;background:var(--lime);padding:5px 10px;border-radius:4px;margin-bottom:16px}
      h1{font-size:clamp(30px,4.5vw,44px);font-weight:800;letter-spacing:-.025em;margin-bottom:10px}
      .lede{font-size:16px;color:var(--muted);max-width:640px}
      .integration-nudge{font-size:13.5px;color:var(--muted);margin-top:12px;max-width:640px}
      .integration-nudge strong{color:var(--ink)}
      .levels{display:flex;gap:10px;margin:30px 0 22px}
      @media(max-width:640px){.levels{flex-direction:column}}
      .lvl{flex:1;border:1px solid var(--border);border-radius:var(--r);padding:14px 16px;background:var(--gray-0);position:relative}
      .lvl.passed{background:var(--surface)}
      .lvl.current{border-color:var(--limeB);background:var(--limeS);box-shadow:0 0 0 2px var(--lime) inset}
      .lvl.locked{opacity:.6}
      .lnum{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
      .lname{font-weight:700;font-size:14.5px;margin-top:3px}
      .lstate{position:absolute;top:12px;right:14px;font-size:13px}
      .lvl.current .lstate{font-size:10px;font-weight:700;background:var(--lime);padding:3px 7px;border-radius:4px;text-transform:uppercase}
      .meter{display:flex;align-items:center;gap:18px;flex-wrap:wrap;background:var(--ink);color:#f3efe0;border-radius:14px;padding:20px 24px;margin-bottom:28px}
      .big{font-size:30px;font-weight:800;color:#fff}
      .big .l{color:var(--lime)}
      .mtxt{flex:1;min-width:220px}
      .mtxt .t{font-weight:700;color:#fff}
      .mtxt .s{font-size:13px;color:#cfcabb;margin-top:2px}
      .bar{height:9px;background:#3a352a;border-radius:6px;overflow:hidden;max-width:300px;margin-top:10px}
      .bar>span{display:block;height:100%;background:var(--lime);border-radius:6px;transition:width .3s}
      .group{margin-bottom:26px}
      .gh{font-size:16px;font-weight:800;margin-bottom:2px}
      .gs{font-size:13px;color:var(--muted);margin-bottom:14px}
      .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
      @media(max-width:640px){.grid{grid-template-columns:1fr}}
      .card{border:1px solid var(--border);border-radius:var(--r);background:var(--gray-0);cursor:pointer;transition:.12s}
      .card:hover{border-color:var(--ink)}
      .card.confirmed,.card.imported{background:var(--limeS);border-color:var(--limeB)}
      .card.inferred{background:#eef7fb;border-color:var(--sky)}
      .card.drafted{background:var(--butter);border-color:var(--butter)}
      .card-main{padding:16px 18px}
      .cname{font-weight:700;font-size:15px}
      .cwhy{font-size:13px;color:var(--muted);margin:6px 0 12px;min-height:34px}
      .foot{display:flex;align-items:center;justify-content:space-between;gap:10px}
      .st{font-size:12px;font-weight:700;padding:4px 9px;border-radius:4px}
      .st.confirmed,.st.imported{background:var(--green);color:#fff}
      .st.inferred{background:var(--sky);color:#0b4a59}
      .st.drafted{background:var(--greenD);color:#fff}
      .st.missing{background:var(--butter);color:#6e5500}
      .foot .cta{font-size:13px;font-weight:700;color:var(--ink)}
      .card-panel{display:none;border-top:1px solid var(--border);padding:16px 18px;font-size:13.5px;color:var(--ink);background:rgba(255,255,255,.55);max-height:420px;overflow:auto}
      .card.open .card-panel{display:block}
      .card-panel h1,.card-panel h2,.card-panel h3{font-size:14px;margin:10px 0 4px}
      .card-panel p{margin:6px 0}
      .card-panel .empty{color:var(--muted);font-style:italic}
      .card-panel .enrich{display:block;margin-top:10px;padding:9px 12px;border:1px dashed var(--sky);border-radius:8px;background:#eef7fb;color:#0b4a59;font-size:12.5px}
      .card-panel .enrich strong{color:#0b4a59}
      .help-banner{display:flex;align-items:flex-start;gap:12px;margin-top:32px;padding:16px 20px;border:1px solid var(--border);border-radius:var(--r);background:var(--surface);font-size:14px;color:var(--ink);line-height:1.55}
      .help-banner .icon{font-size:18px;flex-shrink:0;margin-top:1px}
    </style>
  </head>
  <body>
    <div class="wrap">
      <span class="kicker">Context Kit</span>
      <h1>Your Context Kit</h1>
      <p class="lede">The more Runneth knows about your brand, the sharper every answer. Confirm what we pulled, review what we drafted, add the few things only you know. Click any card to see what's saved.</p>
      <p class="integration-nudge" id="nudge">📄 Already have brand docs in Google Drive or Notion? <strong>Connect them in chat</strong> and Runneth can pull from them directly.</p>
      <div id="board"></div>
      <div class="help-banner">
        <span class="icon">💡</span>
        <span><strong>This board mirrors your brain.</strong> Click any card to review what Runneth has saved. Tell Runneth in chat to update anything, or ask it to pull up any file anytime. Refresh after a chat update to see the latest.</span>
      </div>
    </div>

    <script is:inline type="text/javascript">
      const BASE = "/context-kit";
      const statusLabel = { confirmed:"Confirmed", imported:"Imported", inferred:"Confirm this", drafted:"Review draft", missing:"Not yet" };
      const ctaLabel = { confirmed:"View", imported:"View", inferred:"Review & confirm", drafted:"Review draft", missing:"Add / drop file" };
      const buckets = [
        { key:"A", title:"From Motion — just confirm", sub:"Runneth already pulled these from your Motion setup." },
        { key:"B", title:"Runneth drafts these from your data", sub:"We build a draft from your Motion creative, you correct anything off." },
        { key:"C", title:"Only you can answer these", sub:"The few things no data source knows." },
      ];
      function esc(s){return (s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");}
      function mdToHtml(md){
        return esc(md)
          .replace(/^### (.*)$/gm,"<h3>$1</h3>")
          .replace(/^## (.*)$/gm,"<h2>$1</h2>")
          .replace(/^# (.*)$/gm,"<h1>$1</h1>")
          .replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")
          .replace(/\n{2,}/g,"</p><p>")
          .replace(/\n/g,"<br>");
      }
      function emptyMsg(item){
        if(item.bucket==="A") return "Not confirmed yet. Tell Runneth \"confirm my "+esc(item.label)+"\" in chat to lock it in.";
        if(item.bucket==="B") return "Runneth hasn't researched this yet. Say \"build my Context Kit\" in chat and Runneth will draft it for you.";
        return "Only you can answer this one. Say \"fill in my "+esc(item.label)+"\" in chat and Runneth will walk you through it.";
      }
      function enrichHtml(item){
        return item.enrich ? "<div class='enrich'>\u2728 <strong>Tip:</strong> "+esc(item.enrich)+"</div>" : "";
      }
      async function loadPanel(item, panel){
        const filled = ["confirmed","imported","drafted"].includes(item.status);
        const file = item.dataFile || (item.id+".md");
        let content;
        if(filled){
          try{
            const r = await fetch(BASE+"/data/"+file,{cache:"no-store"});
            if(!r.ok) throw 0;
            const t = await r.text();
            content = "<p>"+mdToHtml(t)+"</p>";
          }catch(e){
            content = "<p class='empty'>"+ (item.bucket==="B" ? "This file hasn't been saved yet. Say \"build my Context Kit\" in chat and Runneth will fill it in." : emptyMsg(item)) +"</p>";
          }
        } else if(item.bucket==="A" && item.preview){
          content = "<p>"+esc(item.preview)+"</p><p class='empty'>"+emptyMsg(item)+"</p>";
        } else {
          content = "<p class='empty'>"+emptyMsg(item)+"</p>";
        }
        panel.innerHTML = content + enrichHtml(item);
      }
      function render(state){
        const items = state.items || [];
        const total = items.length;
        const confirmed = items.filter(i=>["confirmed","imported"].includes(i.status)).length;
        const pct = total? Math.round(confirmed/total*100):0;
        // hide the Drive/Notion nudge once everything is confirmed
        const nudge = document.getElementById("nudge");
        if(nudge) nudge.style.display = (confirmed===total) ? "none" : "block";
        const board = document.getElementById("board");
        board.innerHTML = "";
        const lv = document.createElement("div"); lv.className="levels";
        (state.levels||[]).forEach(l=>{
          const d=document.createElement("div"); d.className="lvl "+l.state;
          d.innerHTML="<span class='lstate'>"+(l.state==="passed"?"\u2713":l.state==="current"?"You're here":"\uD83D\uDD12")+"</span><div class='lnum'>Level "+l.id.replace("L","")+"</div><div class='lname'>"+esc(l.name)+"</div>";
          lv.appendChild(d);
        });
        board.appendChild(lv);
        const m=document.createElement("div"); m.className="meter";
        m.innerHTML="<div class='big'><span class='l'>"+confirmed+"</span>/"+total+"</div><div class='mtxt'><div class='t'>"+(confirmed===total?"Full context unlocked.":(total-confirmed)+" items left to unlock full context.")+"</div><div class='s'>Confirm the blue ones, review drafts, fill the rest. Say \"build my Context Kit\" in chat.</div><div class='bar'><span style='width:"+pct+"%'></span></div></div>";
        board.appendChild(m);
        buckets.forEach(b=>{
          const list = items.filter(i=>i.bucket===b.key);
          if(!list.length) return;
          const g=document.createElement("div"); g.className="group";
          g.innerHTML="<div class='gh'>"+b.title+"</div><div class='gs'>"+b.sub+"</div>";
          const grid=document.createElement("div"); grid.className="grid";
          list.forEach(item=>{
            const card=document.createElement("div"); card.className="card "+item.status;
            card.innerHTML="<div class='card-main'><div class='cname'>"+esc(item.label)+"</div><div class='cwhy'>"+esc(item.why||"")+"</div><div class='foot'><span class='st "+item.status+"'>"+(statusLabel[item.status]||item.status)+"</span><span class='cta'>"+(ctaLabel[item.status]||"View")+"</span></div></div><div class='card-panel'>Loading...</div>";
            const panel=card.querySelector(".card-panel");
            let loaded=false;
            card.querySelector(".card-main").addEventListener("click",()=>{
              const isOpen=card.classList.contains("open");
              document.querySelectorAll(".card.open").forEach(c=>c.classList.remove("open"));
              if(!isOpen){ card.classList.add("open"); if(!loaded){ loaded=true; loadPanel(item,panel); } }
            });
            grid.appendChild(card);
          });
          g.appendChild(grid); board.appendChild(g);
        });
      }
      (async ()=>{
        try{
          const r = await fetch(BASE+"/data/context-kit-state.json",{cache:"no-store"});
          render(await r.json());
        }catch(e){
          document.getElementById("board").innerHTML="<p class='empty'>Could not load your Context Kit state yet.</p>";
        }
      })();
    </script>
  </body>
</html>
