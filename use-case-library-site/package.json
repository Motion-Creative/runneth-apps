{
  "name": "use-case-library-site",
  "private": true,
  "version": "1.0.0",
  "description": "Runneth Library rebuilding page and supporting services.",
  "type": "module",
  "scripts": {
    "install:all": "pnpm install --recursive",
    "build": "pnpm --filter use-case-library-frontend build && pnpm --filter use-case-library-server build",
    "start": "pnpm --filter use-case-library-server start",
    "dev:frontend": "pnpm --filter use-case-library-frontend dev",
    "dev:server": "pnpm --filter use-case-library-server dev"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@2.1.2": "2.1.3",
      "brace-expansion@5.0.7": "5.0.8",
      "fast-uri@3.1.2": "3.1.4",
      "find-my-way@9.6.0": "9.7.0",
      "postcss@8.5.14": "8.5.18"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.11"
  }
}
