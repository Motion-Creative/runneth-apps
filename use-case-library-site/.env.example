# Port the server listens on. Most hosts (Fly, Render, Railway) inject this themselves.
PORT=3000

# Host bind address. 0.0.0.0 lets the host route traffic in.
HOST=0.0.0.0

# Git ref containing the archived Use Case Library metadata.
# Production uses the immutable pre-cleanup snapshot by default.
RUNNETH_APPS_REF=pre-cleanup-2026-07-21-with-aligned-onboarding

# The rebuilding page is enabled by default. Set this only for local migration
# work when you need to render the archived catalog.
VITE_REVAMP_MODE=true

# Local SQLite paths. Container deployments override these with /data paths.
REVIEWS_DB_PATH=./reviews.db
BRAIN_SUBMISSIONS_DB_PATH=./brain-submissions.db

# Fastify log level. info | warn | error | debug
LOG_LEVEL=info
